rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Explicitly deny access to everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // All user-scoped data lives strictly under users/{userId}
    match /users/{userId} {
      // User Profile and settings document
      allow read, write: if isOwner(userId);

      // Subcollection: Conversations
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);

        // Subcollection: Messages
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Subcollection: Journal Entries
      match /journalEntries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Long-term Memories
      match /memories/{memoryId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Goals & Milestones
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Tasks
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: AI Insights
      match /insights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Daily Reflections
      match /reflections/{reflectionId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: User Settings
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
