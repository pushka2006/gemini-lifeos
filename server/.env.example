PORT=5000
NODE_ENV=development

# Google Gemini API Key (Secret, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin Service Account Credentials
# (Can be provided via individual variables or path to serviceAccountKey.json)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Use escaped newlines (\n) when specifying in single line:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"

# Or path to service account json file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Allowed Frontend Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
